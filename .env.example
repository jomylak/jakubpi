# MAC address of your PC's WIRED ethernet NIC (not WiFi -- WoL needs wired).
# Windows: ipconfig /all, look under "Ethernet adapter", "Physical Address".
PC_MAC=AA:BB:CC:DD:EE:FF

# PC's LAN IP. Set a DHCP reservation for this in your router so it never
# changes -- if it drifts, the proxy silently starts talking to nothing.
PC_IP=192.168.1.50

# Broadcast address for your LAN, almost always this unless you've changed
# your router's subnet.
BROADCAST_IP=192.168.1.255

# Where Ollama listens on the PC once it's up.
OLLAMA_PORT=11434

# How long to wait for the PC to come up after sending the wake packet.
WAKE_TIMEOUT_SECONDS=90
# How often to poll while waiting.
POLL_INTERVAL_SECONDS=2

# Port the proxy itself listens on (on the Pi).
PROXY_PORT=8000

# ---- Auto-sleep ----
# Minutes of ZERO in-flight requests before the proxy tells the PC to
# sleep itself. 0 disables this entirely (you sleep it manually / rely on
# Windows' own idle timer instead). Never fires while any request --
# including any request in a multi-request batch -- is still in flight,
# no matter how long the batch has been running.
SLEEP_AFTER_IDLE_MINUTES=15

# Must match PC_AGENT_TOKEN set on the PC (pc_agent.py). Anyone who can
# guess this token can sleep your PC on demand, so make it a real random
# string -- e.g. `openssl rand -hex 16` -- not a word.
PC_AGENT_TOKEN=
PC_AGENT_PORT=8100
