[Unit]
Description=Wake-on-LAN proxy for local model server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/wakeproxy
ExecStart=%h/wakeproxy/.venv/bin/python app.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
